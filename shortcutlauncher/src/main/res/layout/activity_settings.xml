<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Dap.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Dap.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle" />

        <!-- App de arranque -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_startup" />

        <LinearLayout
            android:id="@+id/targetCard"
            style="@style/Dap.Card.Clickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/targetIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/targetName"
                    style="@style/Dap.Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/targetHint"
                    style="@style/Dap.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dap_ic_chevron"
                app:tint="@color/dap_text_secondary" />
        </LinearLayout>

        <!-- Home por defecto -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_home" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeStatus"
                style="@style/Dap.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeButton"
                style="@style/Dap.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- Retraso al arrancar -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_delay" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Dap.Text.Item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/delay_label" />

                <TextView
                    android:id="@+id/delayValue"
                    style="@style/Dap.Text.Item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/delaySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/delay_label"
                android:stepSize="1"
                android:valueFrom="0"
                android:valueTo="3"
                app:haloColor="@color/dap_ripple"
                app:labelBehavior="gone"
                app:thumbColor="@color/dap_white"
                app:tickVisible="false"
                app:trackColorActive="@color/dap_white"
                app:trackColorInactive="@color/dap_outline" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delay_hint" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testButton"
            style="@style/Dap.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/test_launch" />
    </LinearLayout>
</ScrollView>
