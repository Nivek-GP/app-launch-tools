<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/title"
            style="@style/Dap.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Vista previa: así se verá el tile en Ajustes rápidos. -->
        <LinearLayout
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tile_preview"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <ImageView
                android:id="@+id/previewIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:tint="@color/dap_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/previewLabel"
                    style="@style/Dap.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/previewSubtitle"
                    style="@style/Dap.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- App -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_app" />

        <LinearLayout
            android:id="@+id/appCard"
            style="@style/Dap.Card.Clickable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appName"
                    style="@style/Dap.Text.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/appHint"
                    style="@style/Dap.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dap_ic_chevron"
                app:tint="@color/dap_text_secondary" />
        </LinearLayout>

        <!-- Texto -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/labelInput"
            android:text="@string/section_label" />

        <EditText
            android:id="@+id/labelInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:autofillHints=""
            android:background="@drawable/dap_bg_field"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textCapSentences"
            android:maxLength="24"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textColor="@color/dap_text_primary"
            android:textColorHint="@color/dap_text_disabled"
            android:textSize="16sp" />

        <TextView
            style="@style/Dap.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="@string/label_caption" />

        <!-- Icono -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_icon" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/iconGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/iconCaption"
            style="@style/Dap.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp" />

        <!-- Visibilidad -->
        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_visibility" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/visibleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/visible_switch"
                android:textColor="@color/dap_text_primary"
                android:textSize="16sp"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@color/switch_track_decoration"
                app:trackTint="@color/switch_track" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/visible_caption" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetButton"
            style="@style/Dap.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/reset_slot" />
    </LinearLayout>
</ScrollView>
