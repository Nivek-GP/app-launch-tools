<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Dap.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <TextView
            style="@style/Dap.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/config_subtitle" />

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_tiles" />

        <!-- Las filas de cada slot se añaden desde código (item_slot). -->
        <LinearLayout
            android:id="@+id/slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Dap.Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_howto" />

        <LinearLayout
            style="@style/Dap.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Dap.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/howto_steps" />

            <TextView
                style="@style/Dap.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/howto_tip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
